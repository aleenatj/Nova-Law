# Application Settings
APP_NAME=Nova Law AI Backend
APP_ENV=development
DEBUG=true
VERSION=1.0.0

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
# Individual database parameters (recommended for security)
# Note: Passwords with special characters (@, #, :, etc.) are automatically URL-encoded
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Legacy DATABASE_URL (deprecated - use individual parameters above)
# If using DATABASE_URL directly, ensure passwords with special characters are URL-encoded
# Example: password "test#123@pass" should be "test%23123%40pass"
# DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:POSTGRES_PORT/POSTGRES_DB

# JWT Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
JWE_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=7
RESOLVE_EXPIRY_HOURS=24

# AI/LLM Settings
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LangChain Settings
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=



# CORS Settings
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Frontend URL (required for email links and payment redirects)
FRONTEND_URL=http://localhost:3000
LOGO_URL=https://cloudfront/logo.png

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# AWS Settings
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=eu-west-2

# S3 Settings
S3_BUCKET_NAME=your-s3-bucket-name

# CloudFront Settings (optional - for CDN)
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net
CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-distribution-id

# AWS SES SMTP (for email sending)
AWS_SES_SMTP_USERNAME="your-smtp-username"
AWS_SES_SMTP_PASSWORD="your-smtp-password"
AWS_SES_SMTP_HOST="email-smtp.eu-west-2.amazonaws.com"
AWS_SES_SMTP_PORT=587
DEFAULT_EMAIL_SENDER="your-verified-email@domain.com"

# Stripe Payment Settings (required for payment processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
